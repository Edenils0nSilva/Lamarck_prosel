# Ambiente da aplicação
NODE_ENV=development
PORT=3000

# Regra de negócio: limiar de confiança abaixo do qual o documento vai para conferência
CONFIDENCE_THRESHOLD=0.85

# Processamento da IA (usado pelos adaptadores reais; o dublê ignora)
AI_ADAPTER=stub            # stub | real
AI_TIMEOUT_MS=40000
AI_MAX_ATTEMPTS=3

# Limites de ingestão
MAX_FILE_SIZE_MB=15
ALLOWED_MIME=image/jpeg,image/png,application/pdf

# Infra (adaptadores reais — ainda não usados no esqueleto)
DATABASE_URL=postgres://user:pass@localhost:5432/doc_intelligence
REDIS_URL=redis://localhost:6379
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=documents
