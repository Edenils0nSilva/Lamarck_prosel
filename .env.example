# Ambiente da aplicação
NODE_ENV=development
PORT=3000

# Regra de negócio: limiar de confiança abaixo do qual o documento vai para conferência
CONFIDENCE_THRESHOLD=0.85

# Seleção de adaptadores (Ports & Adapters).
#   memory  → roda sem infra externa (padrão, ótimo para dev e testes)
#   real    → postgres / bullmq / minio (exigem o docker-compose no ar)
PERSISTENCE=memory        # memory | postgres
QUEUE=memory              # memory | bullmq
STORAGE=memory            # memory | minio

# Processamento da IA (o dublê ignora timeout; maxAttempts vale para o retry)
AI_ADAPTER=stub           # stub | real
AI_TIMEOUT_MS=40000
AI_MAX_ATTEMPTS=3

# Limites de ingestão
MAX_FILE_SIZE_MB=15
ALLOWED_MIME=image/jpeg,image/png,application/pdf

# Postgres (usado quando PERSISTENCE=postgres)
DATABASE_URL=postgres://doc:doc@localhost:5432/doc_intelligence

# Redis (usado quando QUEUE=bullmq)
REDIS_URL=redis://localhost:6379

# MinIO / S3 (usado quando STORAGE=minio)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=documents
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
